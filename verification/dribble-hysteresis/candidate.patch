+    def test_dribble_lateral_correction_has_separate_entry_and_exit(self):
+        d = Decision('DRIBBLE', (-.19, 0), (1, 0))
+        for side, action in ((1, 'step_left'), (-1, 'step_right')):
+            with self.subTest(side=side):
+                nav = Navigator()
+                errors = (.09, .11, .09, .07, .09)
+                actions = [nav.choose(d, [-.19, -side*error], 0, [0, 0])[0]
+                           for error in errors]
+                self.assertEqual(actions, ['walk', action, action, 'walk', 'walk'])
+
+    def test_dribble_lateral_state_resets_during_other_navigation(self):
+        d = Decision('DRIBBLE', (-.19, 0), (1, 0))
+        cases = ((d, [-1, 0], 0), (d, [-.19, -.09], math.pi/2),
+                 (Decision('SUPPORT', (0, 0), (1, 0)), [-.19, -.09], 0))
+        for decision, own, yaw in cases:
+            with self.subTest(behaviour=decision.behaviour, own=own, yaw=yaw):
+                nav = Navigator()
+                self.assertEqual(nav.choose(d, [-.19, -.11], 0, [0, 0])[0], 'step_left')
+                nav.choose(decision, own, yaw, [0, 0])
+                self.assertFalse(nav.dribble_lateral_active)
+                self.assertEqual(nav.choose(d, [-.19, -.09], 0, [0, 0])[0], 'walk')
+
+    def test_shoot_alignment_does_not_inherit_dribble_tolerance(self):
+        nav = Navigator()
+        dribble = Decision('DRIBBLE', (-.19, 0), (1, 0))
+        nav.choose(dribble, [-.19, -.11], 0, [0, 0])
+        shoot = Decision('SHOOT', (-.17, -.05), (1, 0), 'shoot')
+        self.assertEqual(nav.choose(shoot, [-.18, -.09], 0, [0, 0])[0], 'shoot')
+        self.assertFalse(nav.dribble_lateral_active)
+        self.assertEqual(nav.choose(shoot, [-.18, -.11], 0, [0, 0])[0], 'step_left')
+
